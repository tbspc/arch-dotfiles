{
  "manifest_version": 3,
  "name": "Impasto blank-tab colours",
  "version": "1.0.0",
  "description": "Refreshes native blank tabs when the Impasto palette changes. Normal websites are untouched.",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}